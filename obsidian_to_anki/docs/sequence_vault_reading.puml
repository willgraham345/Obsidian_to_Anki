@startuml sequence_vault_reading
title Reading an Obsidian Vault

participant App
participant Directory
participant File
participant "Note / InlineNote" as Note
participant FormatConverter
participant NoteDB
participant globals

App -> Directory : __init__(abspath, regex=False)
activate Directory

loop for each file in directory (all files treated as markdown)
  Directory -> File : __init__(filepath)
  activate File
  File -> File : read file content (utf-8)
  File --> Directory : File instance
  deactivate File

  Directory -> globals : check FILE_HASHES[filepath]
  alt file hash unchanged
    Directory -> Directory : skip file
  else file is new or changed
    Directory -> File : scan_file()
    activate File

    File -> File : _setup_scan()
    note right: calls setup_frozen_fields_dict(),\nsetup_target_deck(), setup_global_tags()\nand initialises all note lists to []\n(including uuid_for_add, uuid_for_inline_add)

    loop for each NOTE_REGEXP match (START...END block)
      File -> File : _handle_block_note(match)
      activate File

      File -> Note : __init__(note_text)
      activate Note
      Note -> Note : parse ID from last line
      Note -> Note : parse Tags from penultimate line
      Note -> Note : set note_type from first line
      Note --> File : Note instance
      deactivate Note

      File -> Note : parse(deck, url, frozen_fields_dict)
      activate Note
      Note -> Note : access fields property
      loop for each field line
        Note -> FormatConverter : format(field_text, cloze)
        activate FormatConverter
        FormatConverter -> FormatConverter : obsidian_to_anki_math()
        FormatConverter -> FormatConverter : protect math & code blocks
        FormatConverter -> FormatConverter : curly_to_cloze() [if enabled]
        FormatConverter -> FormatConverter : markdown_parse() via globals.md_parser
        FormatConverter -> FormatConverter : restore math (HTML-escaped)
        FormatConverter -> FormatConverter : get_images() + get_audio()
        FormatConverter -> globals : store base64 media in MEDIA dict
        FormatConverter -> FormatConverter : fix_image_src() + fix_audio_src()
        FormatConverter -> FormatConverter : strip outer <p> tags
        FormatConverter --> Note : HTML string
        deactivate FormatConverter
      end
      Note -> globals : read NOTE_DICT_TEMPLATE
      Note --> File : Note_and_id(note_dict, id)
      deactivate Note

      File -> File : _apply_change_detection(parsed, file_path, line_no)
      note right
        Only runs when globals.NOTE_DB is set
        and the note has no existing Anki ID.
        Looks up (file_path, line_no, note_type) in DB.
        If content (field_1 / field_2) has changed:
          → queue old anki_id in notes_to_delete
          → treat note as new (re-add to Anki)
      end note

      alt id is None (new note)
        File -> NoteDB : get_note_by_location(file_path, line_no, note_type)
        NoteDB --> File : existing record or None
        File -> NoteDB : upsert_note(uuid, anki_id=None,\n  file_path, line_number, note_type,\n  field_1, field_2, image_paths,\n  tags, deck_name)
        note right: uuid is reused if record exists,\notherwise a new UUID is generated
        File -> File : append to notes_to_add\nrecord position in id_indexes\nappend uuid to uuid_for_add
      else id in globals.EXISTING_IDS (existing)
        File -> NoteDB : upsert_note(uuid, anki_id=id, ...)
        File -> File : append to notes_to_edit
      else id unknown
        File -> File : log warning
      end

      deactivate File
    end

    loop for each INLINE_REGEXP match (STARTI...ENDI)
      File -> File : _handle_inline_note(match)
      note right: same flow as block note;\nfields parsed by space-separated tokens;\nDB upsert + change detection identical
      File -> File : append to inline_notes_to_add\nor notes_to_edit
    end

    loop for each EMPTY_REGEXP match (deleted notes)
      File -> File : extract ID\nappend to notes_to_delete
    end

    File --> Directory : (scan complete)
    deactivate File

    Directory -> Directory : append to files_changed list
  end
end

Directory -> Directory : self.files = files_changed
Directory --> App : Directory instance
deactivate Directory

@enduml
