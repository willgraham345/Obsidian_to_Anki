@startuml sequence_anki_connect
title Connecting to Anki via AnkiConnect

participant App
participant Config
participant AnkiConnect
participant "Anki Desktop\n(port 8765)" as Anki
participant globals

== Startup: Config Initialization ==

App -> Config : update_config()
activate Config

Config -> AnkiConnect : invoke("modelNames")
activate AnkiConnect
AnkiConnect -> AnkiConnect : request("modelNames")\n→ {action, params:{}, version:6}
AnkiConnect -> Anki : HTTP POST localhost:8765\nContent-Type: application/json
activate Anki
Anki --> AnkiConnect : {"result": ["Basic","Cloze",...], "error": null}
deactivate Anki
AnkiConnect -> AnkiConnect : parse(response)\nvalidate 2 fields, check error is null
AnkiConnect --> Config : ["Basic", "Cloze", ...]
deactivate AnkiConnect

Config -> Config : write [Custom Regexps] section\nwith one entry per model name
Config -> Config : write config file to disk
Config --> App : (config updated)
deactivate Config

== App Initialization: Fetch Fields ==

App -> AnkiConnect : invoke("multi", actions=[\n  modelFieldNames("Basic"),\n  modelFieldNames("Cloze"), ...\n])
activate AnkiConnect
AnkiConnect -> AnkiConnect : request("multi", actions=[...])
AnkiConnect -> Anki : HTTP POST localhost:8765
activate Anki
Anki --> AnkiConnect : {"result": [["Front","Back"],["Text"],...], "error": null}
deactivate Anki
AnkiConnect -> AnkiConnect : parse(response)
AnkiConnect --> App : [["Front","Back"], ["Text"], ...]
deactivate AnkiConnect

App -> globals : FIELDS_DICT = {"Basic":["Front","Back"], "Cloze":["Text"], ...}

== App Initialization: Fetch Existing IDs ==

App -> AnkiConnect : invoke("findNotes", query="deck:*")
activate AnkiConnect
AnkiConnect -> Anki : HTTP POST localhost:8765
activate Anki
Anki --> AnkiConnect : {"result": [1234567890, 9876543210, ...], "error": null}
deactivate Anki
AnkiConnect -> AnkiConnect : parse(response)
AnkiConnect --> App : [1234567890, 9876543210, ...]
deactivate AnkiConnect

App -> globals : EXISTING_IDS = [1234567890, ...]

== Error Handling ==

note over AnkiConnect, Anki
  If Anki is not running or AnkiConnect is not installed:
  - urllib raises ConnectionRefusedError
  - __main__.py catches this and auto-launches Anki
  - then retries the connection

  If AnkiConnect returns {"error": "some message", "result": null}:
  - AnkiConnect.parse() raises an Exception with the error message
end note

@enduml
