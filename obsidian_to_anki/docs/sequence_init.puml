@startuml sequence_init
title Class Initialization Sequences

participant "__main__" as Main
participant App
participant Config
participant Data
participant NoteDB
participant AnkiConnect
participant "Anki Desktop\n(port 8765)" as Anki
participant Directory
participant File
participant globals

' ─── Entry Point ──────────────────────────────────────────────────────────────

== __main__.py Entry ==

Main -> Main : wait_for_port(8765)\n[or launch Anki via load_anki(config)]
note right
  If AnkiConnect not responding on port 8765,
  __main__ auto-launches Anki via subprocess
  and waits up to 30 s for the port to open.
end note

Main -> Config : Config()
activate Config
Config -> Config : CONFIG_PATH = normpath(…/obsidian_to_anki_config.ini)
Config --> Main : config instance
deactivate Config

Main -> App : App(config)
activate App

' ─── App.__init__() ───────────────────────────────────────────────────────────

== App.__init__(config) ==

App -> NoteDB : NoteDB()
activate NoteDB
NoteDB -> NoteDB : sqlite3.connect(DEFAULT_DB_PATH)
NoteDB -> NoteDB : _create_tables()\n(CREATE TABLE IF NOT EXISTS:\n  notes, file_hashes,\n  added_media, anki_notes;\n  DROP + CREATE VIEW note_comparison)
NoteDB --> App : db instance
deactivate NoteDB
App -> globals : NOTE_DB = db

App -> Config : load_config()
activate Config
note right: See sequence_config.puml for detail.\nPopulates globals.CONFIG_DATA,\nNOTE_DICT_TEMPLATE, EMPTY_REGEXP,\nCUSTOM_REGEXPS, FILE_STEM_NOTES,\nFOLDER_DECKS.
Config --> App : (globals populated)
deactivate Config

alt load_config() raises exception
  App -> Config : update_config()
  note right: Fetches modelNames from Anki,\nwrites defaults to .ini, saves to disk.
  App -> Config : load_config()
end

App -> Data : Data()
activate Data
Data -> Data : DATA_PATH = normpath(…/obsidian_to_anki_data.json)
Data --> App : data instance
deactivate Data

App -> Data : load_data_file()
activate Data
Data -> Data : _db() → globals.NOTE_DB
activate Data
note right: Lazy connect — reuses globals.NOTE_DB\nif already set; creates new NoteDB otherwise.
deactivate Data
Data -> NoteDB : get_added_media()
NoteDB --> Data : [filename, …]
Data -> NoteDB : get_all_file_hashes()
NoteDB --> Data : {file_path: sha256, …}

alt DB empty AND JSON backup exists
  Data -> Data : json.load(DATA_PATH)
  note right
    First-run migration:
    seeds DB from legacy obsidian_to_anki_data.json
    (added media + file hashes).
    Falls back silently on JSON parse errors.
  end note
  loop for each media filename in legacy JSON
    Data -> NoteDB : add_media(filename)
  end
  loop for each path/hash in legacy JSON
    Data -> NoteDB : set_file_hash(path, sha256)
  end
  Data -> NoteDB : get_added_media()
  Data -> NoteDB : get_all_file_hashes()
end

Data -> globals : ADDED_MEDIA = [filename, …]
Data -> globals : FILE_HASHES = {file_path: sha256, …}
Data --> App : (globals populated)
deactivate Data

alt load_data_file() raises exception
  App -> Data : create_data_file()
  note right: Creates NoteDB tables + writes empty JSON
  App -> Data : load_data_file()
end

App -> App : get_fields()
activate App
App -> AnkiConnect : invoke("multi", actions=[\n  modelFieldNames(type) for each type\n  in globals.FIELDS_DICT keys\n])
activate AnkiConnect
AnkiConnect -> Anki : HTTP POST — multi modelFieldNames
Anki --> AnkiConnect : [["Front","Back"], ["Text"], …]
AnkiConnect --> App : field name lists
deactivate AnkiConnect
App -> globals : FIELDS_DICT = {"Basic":["Front","Back"], …}
deactivate App

App -> App : get_ids()
activate App
App -> AnkiConnect : invoke("findNotes", query="deck:*")
activate AnkiConnect
AnkiConnect -> Anki : HTTP POST — findNotes
Anki --> AnkiConnect : [note_id, …]
AnkiConnect --> App : all existing note IDs
deactivate AnkiConnect
App -> globals : EXISTING_IDS = [note_id, …]
deactivate App

App -> App : gen_regexp()
activate App
note right
  Compiles regexes from globals.CONFIG_DATA and stores in globals:
  ────────────────────────────────────────────────────
  NOTE_REGEXP      block note start/end pattern
  INLINE_REGEXP    inline note start/end pattern
  DECK_REGEXP      TARGET DECK line pattern
  TAG_REGEXP       FILE TAGS line pattern
  FROZEN_REGEXP    FROZEN field line pattern
  EMPTY_REGEXP     DELETE + ID pattern (already set by load_syntax;
                   gen_regexp may recompile with Comment flag)
  INLINE_EMPTY_REGEXP  inline delete pattern
  VAULT_PATH_REGEXP    vault path stripping pattern
end note
App -> globals : NOTE_REGEXP, INLINE_REGEXP,\nDECK_REGEXP, TAG_REGEXP,\nFROZEN_REGEXP, EMPTY_REGEXP,\nINLINE_EMPTY_REGEXP,\nVAULT_PATH_REGEXP = compiled patterns
deactivate App

App --> Main : App fully initialized
deactivate App

' ─── Directory.__init__() ─────────────────────────────────────────────────────

== Directory.__init__(abspath, onefile=None) ==

Main -> Directory : Directory(abspath)
activate Directory

Directory -> Directory : self.path = abspath\nself.parent = os.getcwd()\nos.chdir(abspath)

alt onefile provided
  Directory -> File : File(onefile)
  activate File
  File --> Directory : File instance
  deactivate File
  Directory -> Directory : self.files = [single_file]
else full directory scan
  Directory -> Directory : os.scandir()
  loop for each entry.is_file()
    Directory -> File : File(entry.path)
    activate File
    File --> Directory : File instance
    deactivate File
  end
  Directory -> Directory : sort by _natural_sort_key\n(alphanumeric natural order)
end

loop for each file in self.files
  Directory -> globals : check FILE_HASHES[file.filename]
  alt hash unchanged (file seen before, not modified)
    Directory -> Directory : skip — print "Skipping {filename}"
  else new or changed file
    Directory -> File : scan_file()
    note right: See sequence_vault_reading.puml for detail.\nPopulates notes_to_add, notes_to_edit,\nnotes_to_delete, inline_notes_to_add.
    Directory -> Directory : files_changed.append(file)
  end
end

Directory -> Directory : self.files = files_changed\nos.chdir(self.parent)
Directory --> Main : Directory instance
deactivate Directory

' ─── File.__init__() ──────────────────────────────────────────────────────────

== File.__init__(filepath) [called by Directory] ==

note over File
  File.__init__ is called for every entry in the directory scan above.
  Shown here in isolation for clarity.
end note

Directory -> File : File(filepath)
activate File

File -> File : self.filename = filepath
File -> File : self.path = os.path.abspath(filepath)
File -> File : self.file_stem = os.path.splitext(basename)[0]

alt vault configured AND path matches VAULT_PATH_REGEXP
  File -> File : build obsidian://open?vault=…&file=… URL\n→ self.url (used as file link in Anki cards)
else
  File -> File : self.url = ""
end

File -> File : open(filename, encoding='utf_8').read()\n→ self.file (full markdown content as string)

File --> Directory : File instance (file content in memory)
deactivate File

@enduml
