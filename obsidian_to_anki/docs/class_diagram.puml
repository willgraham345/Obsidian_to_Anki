@startuml class_diagram
title Obsidian to Anki — Class Diagram

skinparam classAttributeIconSize 0
skinparam groupInheritance 2
hide empty members

package "Orchestration" {
  class App {
    + get_fields()
    + get_ids()
    + get_add_media()
    + gen_regexp()
    + setup_cli_parser()
  }

  class Config {
    + load_config()
    + update_config()
    + load_syntax(config)
    + load_defaults(config)
    + setup_syntax(config)
    + setup_defaults(config)
  }

  class Data {
    + DATA_PATH: str
    + create_data_file()
    + load_data_file()
    + update_data_file(data)
  }
}

package "Persistence" {
  class NoteDB {
    + db_path: str
    + upsert_note(uuid, anki_id, file_path,\n  line_number, note_type,\n  field_1, field_2,\n  image_paths, tags, deck_name)
    + get_note(uuid): dict
    + get_note_by_location(file_path,\n  line_number, note_type): dict
    + delete_note(uuid)
    + get_notes_for_file(file_path): list
    + mark_synced(uuid, anki_id)
    + get_file_hash(file_path): str
    + set_file_hash(file_path, sha256)
    + get_all_file_hashes(): dict
    + add_media(filename)
    + get_added_media(): list
    + close()
  }

  note right of NoteDB
    SQLite tables:
    • notes (UUID PK, anki_id,
      file_path, line_number,
      note_type, field_1, field_2,
      image_paths, tags, deck_name,
      created_at, updated_at)
    • file_hashes (file_path PK,
      sha256, updated_at)
    • added_media (filename PK)
  end note
}

package "AnkiConnect" {
  class AnkiConnect {
    + port: int
    + request(action, **params): dict
    + invoke(action, **params): dict
    + parse(response): dict
  }
}

package "File Processing" {
  class Directory {
    + files: list
    + requests_1(): dict
    + parse_requests_1(response, tags)
    + requests_2(): dict
    + hashes(): dict
  }

  class File {
    + filepath: str
    + notes_to_add: list
    + notes_to_edit: list
    + notes_to_delete: list
    + uuid_for_add: list
    + uuid_for_inline_add: list
    + _setup_scan()
    + scan_file()
    + _handle_block_note(match)
    + _handle_inline_note(match)
    + _apply_change_detection(parsed,\n  file_path, line_no): Note_and_id
    + _line_of(char_pos): int
    + _vault_rel_path(): str
    + write_ids()
    + update_db_anki_ids()
    + write_file()
    + remove_empties()
    + get_add_notes(): dict
    + get_update_fields(): dict
    + get_delete_notes(): dict
    + get_note_info(): dict
    + get_change_decks(): dict
    + get_add_tags(): dict
    + get_clear_tags(): dict
    + setup_target_deck()
    + setup_global_tags()
    + setup_frozen_fields_dict()
  }

  class RegexFile {
    - _DOUBLE_NEWLINE_ID_REGEXP: Pattern
    + search(note_type, regexp)
    + add_spans_to_ignore()
    + fix_newline_ids()
    - {static} _drop_first_char(m): str
  }
}

package "Note Parsing" {
  class Note {
    + text: str
    + identifier: int
    + tags: list
    + note_type: str
    + fields: dict <<property>>
    + field_from_line(line): str
    + parse(deck, url, frozen_fields_dict): Note_and_id
  }

  class InlineNote {
    + text: str
    + identifier: int
    + tags: list
    + note_type: str
    + fields: dict <<property>>
  }

  class RegexNote {
    + match: Match
    + note_type: str
    + groups: list
    + identifier: int
    + tags: list
    + fields: dict <<property>>
    + parse(deck, url, frozen_fields_dict): Note_and_id
  }

  class Note_and_id <<namedtuple>> {
    + note: dict
    + id: int
  }
}

class FormatConverter <<static>> {
  + format(note_text, cloze): str
  + obsidian_to_anki_math(text): str
  + curly_to_cloze(text): str
  + markdown_parse(text): str
  + get_images(html): str
  + get_audio(html): str
  + fix_image_src(html): str
  + fix_audio_src(html): str
  + format_note_with_url(note, url)
  + format_note_with_frozen_fields(note, frozen)
}

class globals <<module>> {
  + CONFIG_DATA: dict
  + FIELDS_DICT: dict
  + NOTE_DICT_TEMPLATE: dict
  + EXISTING_IDS: list
  + MEDIA: dict
  + ADDED_MEDIA: list
  + FILE_HASHES: dict
  + NOTE_DB: NoteDB
  + NOTE_REGEXP: Pattern
  + INLINE_REGEXP: Pattern
  + EMPTY_REGEXP: Pattern
  + ANKI_CLOZE_REGEXP: Pattern
  + OBS_INLINE_MATH_REGEXP: Pattern
  + OBS_DISPLAY_MATH_REGEXP: Pattern
  + OBS_CODE_REGEXP: Pattern
  + OBS_DISPLAY_CODE_REGEXP: Pattern
  + md_parser: Markdown
  + ANKI_PORT: int
}

' Orchestration relationships
App "1" --> "1" Config : uses
App "1" --> "1" Data : uses
App "1" --> "1..*" Directory : creates
App "1" --> "1" AnkiConnect : uses
App "1" --> "1" NoteDB : creates\n(sets globals.NOTE_DB)

' Persistence relationships
Data "1" --> "1" NoteDB : primary store\n(JSON is backup)
File ..> NoteDB : upsert/query via\nglobals.NOTE_DB

' File processing relationships
Directory "1" --> "1..*" File : creates/manages
RegexFile --|> File : extends

' Note creation
File ..> Note : creates
File ..> InlineNote : creates
RegexFile ..> RegexNote : creates

' Note results
Note ..> Note_and_id : returns
RegexNote ..> Note_and_id : returns

' Format conversion
Note ..> FormatConverter : calls format()
InlineNote ..> FormatConverter : calls format()
RegexNote ..> FormatConverter : calls format()

' Config and AnkiConnect
Config ..> AnkiConnect : invoke() on update

' Global state reads/writes
Config ..> globals : writes CONFIG_DATA
Data ..> globals : writes FILE_HASHES\nADDED_MEDIA
FormatConverter ..> globals : reads md_parser\nwrites MEDIA
Note ..> globals : reads FIELDS_DICT\nNOTE_DICT_TEMPLATE
Directory ..> globals : reads FILE_HASHES
RegexFile ..> globals : reads OBS_*_REGEXP
App ..> globals : writes FIELDS_DICT\nEXISTING_IDS\nNOTE_DB

@enduml
