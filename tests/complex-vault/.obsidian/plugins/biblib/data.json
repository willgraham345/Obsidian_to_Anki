{
  "attachmentFolderPath": "Docs_Research_Industry/research_citations/attachments",
  "literatureNotePath": "Docs_Research_Industry/research_citations/",
  "filenameTemplate": "@{{citekey}}",
  "createAttachmentSubfolder": true,
  "bibliographyJsonPath": "biblib/bibliography.json",
  "citekeyListPath": "citekeylist.md",
  "bibtexFilePath": "biblib/bibliography.bib",
  "headerTemplate": "# {{title}}\n\n## Summary\n\n## Quotes\n\n## Thoughts\n\n## References\n{{#pdflink}}📄 [[{{pdflink}}]]{{/pdflink}}\n{{#URL}}🔗 [Source]({{URL}}){{/URL}}",
  "chapterHeaderTemplate": "# {{#pdflink}}[[{{pdflink}}|{{title}}]]{{/pdflink}}{{^pdflink}}{{title}}{{/pdflink}} (in {{container-title}})",
  "literatureNoteTag": "research/literature_note",
  "openNoteOnCreate": true,
  "enableZoteroConnector": true,
  "zoteroConnectorPort": 23119,
  "tempPdfPath": "",
  "customFrontmatterFields": [
    {
      "name": "year",
      "template": "{{year}}",
      "enabled": true
    },
    {
      "name": "dateCreated",
      "template": "{{currentDate}}",
      "enabled": true
    },
    {
      "name": "reading-status",
      "template": "to-read",
      "enabled": true
    },
    {
      "name": "aliases",
      "template": "[\"{{title|sentence}}\"]",
      "enabled": true
    },
    {
      "name": "author-links",
      "template": "[{{#authors}}\"[[Author/{{.}}]]\",{{/authors}}]",
      "enabled": true
    },
    {
      "name": "attachment",
      "template": "[{{#attachments}}{{.}},{{/attachments}}]",
      "enabled": true
    },
    {
      "name": "related",
      "template": "",
      "enabled": false
    },
    {
      "name": "rating",
      "template": "",
      "enabled": true
    },
    {
      "name": "summary",
      "template": "",
      "enabled": true
    },
    {
      "name": "type-research",
      "template": "",
      "enabled": true
    }
  ],
  "citekeyOptions": {
    "citekeyTemplate": "{{author|lowercase}}{{title|titleword}}{{year}}",
    "useZoteroKeys": true,
    "minCitekeyLength": 6
  },
  "bulkImportAttachmentHandling": "none",
  "bulkImportAnnoteToBody": true,
  "bulkImportCitekeyPreference": "imported",
  "bulkImportConflictResolution": "skip",
  "favoriteLanguages": [
    {
      "code": "en",
      "name": "English"
    },
    {
      "code": "de",
      "name": "German"
    }
  ],
  "defaultModalFields": [],
  "editRegenerateCitekeyDefault": false,
  "editUpdateCustomFrontmatterDefault": true,
  "editRegenerateBodyDefault": false,
  "editRenameFileOnCitekeyChange": true
}