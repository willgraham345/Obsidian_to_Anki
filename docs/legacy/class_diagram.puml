@startuml class_diagram
title Obsidian to Anki — Class Diagram

skinparam classAttributeIconSize 0
skinparam groupInheritance 2
hide empty members

package "Orchestration" {
  class App {
    + get_fields()
    + get_ids()
    + get_add_media()
    + gen_regexp()
    + setup_cli_parser()
  }

  class Config {
    + load_config()
    + update_config()
    + load_syntax(config)
    + load_defaults(config)
    + setup_syntax(config)
    + setup_defaults(config)
  }

  class Data {
    + create_data_file()
    + load_data_file()
    + update_data_file(data)
  }
}

package "AnkiConnect" {
  class AnkiConnect {
    + port: int
    + request(action, **params): dict
    + invoke(action, **params): dict
    + parse(response): dict
  }
}

package "File Processing" {
  class Directory {
    + files: list
    + requests_1(): dict
    + parse_requests_1(response, tags)
    + requests_2(): dict
    + hashes(): dict
  }

  class File {
    + filepath: str
    + notes_to_add: list
    + notes_to_edit: list
    + notes_to_delete: list
    + scan_file()
    + write_ids()
    + write_file()
    + get_add_notes(): dict
    + get_update_fields(): dict
    + get_delete_notes(): dict
    + get_note_info(): dict
    + get_change_decks(): dict
    + get_add_tags(): dict
    + get_clear_tags(): dict
    + setup_target_deck()
    + setup_global_tags()
    + setup_frozen_fields_dict()
  }

  class RegexFile {
    + search(note_type, regexp)
    + add_spans_to_ignore()
    + fix_newline_ids()
  }
}

package "Note Parsing" {
  class Note {
    + text: str
    + identifier: int
    + tags: list
    + note_type: str
    + fields: dict <<property>>
    + field_from_line(line): str
    + parse(deck, url, frozen_fields_dict): Note_and_id
  }

  class InlineNote {
    + text: str
    + identifier: int
    + tags: list
    + note_type: str
    + fields: dict <<property>>
  }

  class RegexNote {
    + match: Match
    + note_type: str
    + groups: list
    + identifier: int
    + tags: list
    + fields: dict <<property>>
    + parse(deck, url, frozen_fields_dict): Note_and_id
  }

  class Note_and_id <<namedtuple>> {
    + note: dict
    + id: int
  }
}

class FormatConverter <<static>> {
  + format(note_text, cloze): str
  + convert_math(text): str
  + curly_to_cloze(text): str
  + markdown_parse(text): str
  + get_images(html): str
  + get_audio(html): str
  + fix_image_src(html): str
  + fix_audio_src(html): str
  + format_note_with_url(note, url)
  + format_note_with_frozen_fields(note, frozen)
}

class globals <<module>> {
  + CONFIG_DATA: dict
  + FIELDS_DICT: dict
  + NOTE_DICT_TEMPLATE: dict
  + EXISTING_IDS: list
  + MEDIA: dict
  + ADDED_MEDIA: list
  + FILE_HASHES: dict
  + NOTE_REGEXP: Pattern
  + INLINE_REGEXP: Pattern
  + EMPTY_REGEXP: Pattern
  + md_parser: Markdown
  + ANKI_PORT: int
}

' Orchestration relationships
App "1" --> "1" Config : uses
App "1" --> "1" Data : uses
App "1" --> "1..*" Directory : creates
App "1" --> "1" AnkiConnect : uses

' File processing relationships
Directory "1" --> "1..*" File : creates/manages
RegexFile --|> File : extends

' Note creation
File ..> Note : creates
File ..> InlineNote : creates
RegexFile ..> RegexNote : creates

' Note results
Note ..> Note_and_id : returns
RegexNote ..> Note_and_id : returns

' Format conversion
Note ..> FormatConverter : calls format()
InlineNote ..> FormatConverter : calls format()
RegexNote ..> FormatConverter : calls format()

' Config and AnkiConnect
Config ..> AnkiConnect : invoke() on update

' Global state reads/writes
Config ..> globals : writes CONFIG_DATA
Data ..> globals : writes FILE_HASHES\nADDED_MEDIA
FormatConverter ..> globals : reads md_parser\nwrites MEDIA
Note ..> globals : reads FIELDS_DICT\nNOTE_DICT_TEMPLATE
Directory ..> globals : reads FILE_HASHES\nSUPPORTED_EXTS
App ..> globals : writes FIELDS_DICT\nEXISTING_IDS

@enduml
